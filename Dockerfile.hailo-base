FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

ARG HAILORT_VERSION=5.3.0
ARG DEB_ARCH=arm64
ARG WHL_ARCH=aarch64

RUN apt-get update && apt-get install -y software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa -y \
    && apt-get update && apt-get install -y \
    python3.12 python3.12-dev python3.12-venv \
    python3-pip build-essential pciutils libusb-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.12 as the default python3
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && update-alternatives --set python3 /usr/bin/python3.12

# Keep third-party packages isolated from Ubuntu's externally managed Python.
RUN python3.12 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

COPY hailo-rt-5/hailort* /tmp/

RUN dpkg -i /tmp/hailort_${HAILORT_VERSION}_${DEB_ARCH}.deb \
    && rm /tmp/hailort_${HAILORT_VERSION}_${DEB_ARCH}.deb \
    && ldconfig

RUN pip install --no-deps /tmp/hailort-${HAILORT_VERSION}-cp312-cp312-linux_${WHL_ARCH}.whl \
    && pip install argcomplete contextlib2 future netaddr "numpy<2" \
    && rm /tmp/hailort-${HAILORT_VERSION}-cp312-cp312-linux_${WHL_ARCH}.whl

# Remove build tools no longer needed at runtime
RUN apt-get purge -y --auto-remove build-essential python3.12-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

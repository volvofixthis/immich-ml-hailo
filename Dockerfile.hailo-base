FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

ARG HAILORT_VERSION=4.23.0
ARG DEB_ARCH=arm64
ARG WHL_ARCH=aarch64

RUN apt-get update && apt-get install -y software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa -y \
    && apt-get update && apt-get install -y \
    python3.13 python3.13-dev python3.13-venv \
    python3-pip build-essential pciutils \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.13 as the default python3
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.13 1 \
    && update-alternatives --set python3 /usr/bin/python3.13

# Install pip for Python 3.13 specifically
RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.13

COPY hailo-rt-4/hailort* /tmp/

RUN dpkg -i /tmp/hailort_${HAILORT_VERSION}_${DEB_ARCH}.deb \
    && rm /tmp/hailort_${HAILORT_VERSION}_${DEB_ARCH}.deb \
    && ldconfig

RUN pip3 install --no-deps /tmp/hailort-${HAILORT_VERSION}-cp313-cp313-linux_${WHL_ARCH}.whl \
    && pip3 install argcomplete contextlib2 future netaddr "numpy<2" \
    && rm /tmp/hailort-${HAILORT_VERSION}-cp313-cp313-linux_${WHL_ARCH}.whl

# Remove build tools no longer needed at runtime
RUN apt-get purge -y --auto-remove build-essential python3.13-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
